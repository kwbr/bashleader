#!/usr/bin/expect -f
set timeout 20
set test_dir [file dirname [file normalize [info script]]]
set driver [file join $test_dir binding_lifecycle.bash]
set fake_bin [file join $test_dir fake-bin]
set bash [string trim [exec sh -c {command -v bash}]]

spawn -noecho $bash --noprofile --norc
send -- "PS1='LEADR_TEST> '; export PATH='$fake_bin':\$PATH; export LEADR_TEST_SELECTION=gc; source '$driver'\r"
expect {
  -re {BINDING_TEST_OK} {}
  -re {BINDING_TEST_FAIL:[^\r\n]*} {
    puts stderr $expect_out(0,string)
    exit 1
  }
  timeout {
    puts stderr "binding integration test timed out"
    exit 1
  }
  eof {
    puts stderr "binding integration test exited without success"
    exit 1
  }
}
expect -re {LEADR_TEST> }

# The fake fzf makes picker outcomes deterministic while this PTY test covers
# binding invocation, cursor placement, cancellation, execution, and redraw.
send -- "\x07"
after 100
send -- "OK"
expect -re {git commit -m "OK"}
send -- "\x03"
expect -re {LEADR_TEST> }

send -- "export LEADR_TEST_SELECTION=cancel\r"
expect -re {LEADR_TEST> }
send -- "\x07"
expect -re {LEADR_TEST> }
send -- "echo CANCEL_OK\r"
expect -re {CANCEL_OK}
expect -re {LEADR_TEST> }

send -- "export LEADR_TEST_SELECTION=gs\r"
expect -re {LEADR_TEST> }
send -- "\x07"
expect -re {\+ git status}
expect -re {LEADR_TEST> }
send -- "exit 0\r"
expect eof

set result [wait]
set status [lindex $result 3]
if {$status != 0} {
  puts stderr "interactive Bash exited with status $status"
  exit $status
}
puts "interactive lifecycle test passed"
